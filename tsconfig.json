{
    "extends": "./node_modules/@microsoft/rush-stack-compiler-5.3/includes/tsconfig-web.json",
    "compilerOptions": {
        "target": "es6",
        "forceConsistentCasingInFileNames": true,
        "module": "esnext",
        "moduleResolution": "node",
        // "ignoreDeprecations": "5.0",
        "jsx": "react",
        "declaration": true,
        "sourceMap": true,
        "experimentalDecorators": true,
        "skipLibCheck": true,
        "outDir": "lib",
        "inlineSources": false,
        "noImplicitAny": true,

        "typeRoots": ["./node_modules/@types", "./node_modules/@microsoft"],
        "types": ["webpack-env"],
        "lib": ["es5", "dom", "es2015.collection", "es2015.promise"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/global.d.ts"]
}
